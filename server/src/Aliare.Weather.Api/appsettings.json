{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aliare_weather;Username=postgres;Password=postgres"
  },
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org/data/2.5",
    "GeoUrl": "http://api.openweathermap.org/geo/1.0",
    "ApiKey": "YOUR_API_KEY_HERE"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "Aliare.Weather.Api",
    "Audience": "Aliare.Weather.Client",
    "ExpirationInMinutes": 60
  }
}
